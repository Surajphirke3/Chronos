# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/chronos?retryWrites=true&w=majority

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Public app URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "false" to disable open self-service registration (recommended for production)
ALLOW_PUBLIC_REGISTRATION=true

# Google Cloud OAuth 2.0 Web client (server-side only — never NEXT_PUBLIC_*)
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side Groq key used by AI tools and workflow fallback
GROQ_API_KEY=

# AES-256-GCM encryption key for secrets at rest (32-byte key, base64-encoded)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHRONOS_ENCRYPTION_KEY=

# Shared secret for cron/worker endpoints (workflow resume)
CHRONOS_CRON_SECRET=

# When "true", trust X-Forwarded-For / X-Real-IP for rate limiting (behind known proxies only)
TRUST_PROXY=false

# Per-user daily successful AI request quota (server-side)
AI_USER_DAILY_REQUEST_QUOTA=200

# --- Multi-tenancy (default off / dual-read) ---
# MULTI_TENANT_ENFORCE=false

# --- Phase 5 governance (all default off) ---
# GOVERNANCE_CUSTOM_ROLES_ENABLED=false
# GOVERNANCE_AUDIT_LOGS_ENABLED=false
# GOVERNANCE_API_KEYS_ENABLED=false
# GOVERNANCE_SECURITY_POLICIES_ENABLED=false
# GOVERNANCE_DATA_EXPORT_ENABLED=false
# GOVERNANCE_ENFORCEMENT_ENABLED=false
# API_KEY_PEPPER=

# --- Phase 4 billing (runtime not fully shipped; keep disabled) ---
# BILLING_ENABLED=false
# BILLING_ENFORCE_ENTITLEMENTS=false
# BILLING_PROVIDER=mock_razorpay
# BILLING_MOCK_GATEWAY=false

# --- Phase 6 integrations ---
# INTEGRATIONS_ENABLED=false
# WEBHOOKS_ENABLED=false
# PUBLIC_API_ENABLED=false

# --- Phase 7 AI platform ---
# AI_PLATFORM_ENABLED=false
# AI_AGENTS_ENABLED=false
# KNOWLEDGE_BASES_ENABLED=false

# --- Phase 3 automation workers (keep disabled in production until drill) ---
# AUTOMATION_WORKER_ENABLED=false
# AUTOMATION_SCHEDULER_ENABLED=false
# AUTOMATION_ASYNC_EXECUTE=true

